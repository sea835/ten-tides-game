{
  "name": "ten-tides",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter @tentides/client build",
    "dev": "pnpm --parallel --filter @tentides/server --filter @tentides/client dev",
    "play": "pnpm --filter @tentides/client build && pnpm --parallel --filter @tentides/server --filter @tentides/client serve",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
